{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InboxTriage Contexto Semanal",
  "description": "Fuente de verdad temporal para policy de triaje. Alineado a PITCH.md y CICLO.md Scope 3",
  "type": "object",
  "required": [
    "on_the_plate",
    "stakeholders",
    "deprioritize"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "week_of": {
          "type": "string",
          "description": "ISO date semana, ej 2026-08-18"
        },
        "owner_role": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "enum": [
            "es",
            "en",
            "es/en"
          ]
        }
      }
    },
    "on_the_plate": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "description": "Max 5 items. Que esta en el plato esta semana. Si no cabe aqui, no es Ahora.",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 200
      }
    },
    "stakeholders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "description": "Emails o nombres que si bloquean, son Ahora.",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 120
      }
    },
    "deprioritize": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "description": "Patrones que siempre son NoResponder.",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 120
      }
    }
  }
}