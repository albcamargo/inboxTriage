# InboxTriage - variables de entorno de ejemplo
# Copia a .env y completa los valores: cp .env.example .env
# El .env real esta gitignoreado (RNF-02: secretos solo en disco local).

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3210/oauth2callback

# --- QVAC modelo local (Scope 1) ---
QVAC_MODEL=llama-3.2-1b-instruct-q4
QVAC_MODELS_PATH=./models
# Ponlo en true si QVAC va lento (>30s/mail): 1 completion con 4 preguntas.
QVAC_SINGLE_COMPLETION=false
# Tokens maximos por completion (round-trip de 4 preguntas).
QVAC_MAX_TOKENS=512

# --- Triaje / contexto ---
CONTEXTO_PATH=./contexto.json
LOG_PATH=./triage.log
GMAIL_BATCH_SIZE=15
