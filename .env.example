# InboxTriage - variables de entorno de ejemplo
# Copia a .env y completa los valores: cp .env.example .env
# El .env real esta gitignoreado (RNF-02: secretos solo en disco local).

# --- Gmail OAuth (Scope 2) ---
# Crea un OAuth Client ID (Desktop App) en https://console.cloud.google.com
# con la Gmail API habilitada. Solo necesario para el flujo Gmail real
# (gmail:auth, gmail:labels, gmail:list, gmail:seed). El triaje con fixtures
# y el smoke de QVAC funcionan sin estas variables.
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
# 3210 y no 3000: el 3000 lo suelen ocupar Docker/dev servers.
GOOGLE_REDIRECT_URI=http://localhost:3210/oauth2callback

# --- QVAC modelo local (Scope 1) ---
QVAC_MODEL=llama-3.2-1b-instruct-q4
QVAC_MODELS_PATH=./models
# Ponlo en true si QVAC va lento (>30s/mail): 1 completion con 4 preguntas.
QVAC_SINGLE_COMPLETION=false
# Tokens maximos por completion (round-trip de 4 preguntas).
QVAC_MAX_TOKENS=512

# --- Triaje / contexto ---
CONTEXTO_PATH=./contexto.json
LOG_PATH=./triage.log
GMAIL_BATCH_SIZE=15

# --- Panel local ---
# Puerto del panel (8642 para no chocar con el tipico 8000)
DASHBOARD_API_PORT=8642
