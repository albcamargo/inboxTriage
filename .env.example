# Copia a .env y rellena. Nunca subas .env ni tokens.json.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3210/oauth2callback

QVAC_MODEL=llama-3.2-1b-instruct-q4
QVAC_MODELS_PATH=./models
QVAC_CONFIG_PATH=./qvac.config.js
# false = 4 round-trips (mas lento). Default: 1 completion (recorte CICLO.md)
QVAC_SINGLE_COMPLETION=true

CONTEXTO_PATH=./contexto.json
LOG_PATH=./triage.log
GMAIL_BATCH_SIZE=15

# Puerto del panel local (8642 para no chocar con el tipico 8000)
DASHBOARD_API_PORT=8642
